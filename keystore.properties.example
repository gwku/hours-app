# Copy to keystore.properties and fill in. That file is git-ignored: it holds
# the passwords to the signing key and must never be committed.
#
# Create the key first, from the project root:
#
#   keytool -genkeypair -v \
#     -keystore release-keystore.jks \
#     -alias hours \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Keep release-keystore.jks somewhere safe and backed up. Every update your
# mother installs has to be signed with this same key. Android refuses an
# update signed with a different one, and the only way out is uninstalling,
# which takes the database with it.

storeFile=release-keystore.jks
storePassword=
keyAlias=hours
keyPassword=
