<?xml version="1.0" encoding="utf-8"?>
<!-- Clock with a confirmation badge: the day, already filled in and confirmed.
     Geometry is offset +2.4 from a clock-at-46 layout so the visible ink box
     (clock edge to badge edge) sits centred in the 108 viewport. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Clock face -->
    <path
        android:pathData="M48.4,28.4 a20,20 0 1,0 0,40 a20,20 0 1,0 0,-40"
        android:strokeColor="#F7F4EF"
        android:strokeWidth="5.5" />
    <path
        android:pathData="M48.4,48.4 L48.4,35.4"
        android:strokeColor="#F7F4EF"
        android:strokeWidth="5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M48.4,48.4 L57.06,53.4"
        android:strokeColor="#F7F4EF"
        android:strokeWidth="5"
        android:strokeLineCap="round" />

    <!-- Badge, knocked out of the clock face with the background colour -->
    <path
        android:pathData="M69.4,52.9 a16.5,16.5 0 1,0 0,33 a16.5,16.5 0 1,0 0,-33"
        android:fillColor="#2F6B4F" />
    <path
        android:pathData="M69.4,56.4 a13,13 0 1,0 0,26 a13,13 0 1,0 0,-26"
        android:fillColor="#E08A6D" />
    <path
        android:pathData="M63.4,69.9 L67.9,74.4 L75.9,64.4"
        android:strokeColor="#2F6B4F"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
